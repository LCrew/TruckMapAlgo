# Copy to .env and adjust. Never commit .env.

# Port the web app is served on (http://<server>:APP_PORT)
APP_PORT=8081

# Optional: in-app "Report an issue" button → creates GitHub issues in GITHUB_REPO.
# Create a fine-grained personal access token at https://github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories → LCrew/TruckMapAlgo
#   Permissions: Issues → Read and write (nothing else)
# Leave empty to let users open a prefilled GitHub issue themselves instead.
GITHUB_TOKEN=
GITHUB_REPO=LCrew/TruckMapAlgo
